# Phan Rang Center - Environment Variables
# Copy this file to .env.local and fill in your values

# Site URL
NEXT_PUBLIC_SITE_URL=https://phanrangcenter.vn

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Forms
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxx

# Contact
NEXT_PUBLIC_HOTLINE=0900000000
NEXT_PUBLIC_ZALO_LINK=https://zalo.me/0900000000
NEXT_PUBLIC_EMAIL=info@phanrangcenter.vn

# Asset paths (optional - for CDN)
NEXT_PUBLIC_ASSET_BASE_URL=

# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CHAT=true